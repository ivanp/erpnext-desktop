<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Serpy.App.ViewModels"
             xmlns:ui="using:Serpy.App.Text"
             xmlns:views="using:Serpy.App.Views"
             mc:Ignorable="d"
             d:DesignWidth="540"
             d:DesignHeight="520"
             x:Class="Serpy.App.Views.SetupView"
             x:DataType="vm:SetupViewModel">
  <Panel Name="SetupScreenHost"
         AutomationProperties.AutomationId="SetupScreenHost">

    <!-- ============ 2 · Welcome (mockup s2) ============ -->
    <ScrollViewer IsVisible="{Binding ShowWelcome}">
      <StackPanel Name="WelcomeScreen"
                  AutomationProperties.AutomationId="WelcomeScreen"
                  Margin="22,18,22,20"
                  Spacing="12">
        <TextBlock Classes="h1" Text="{x:Static ui:UiText.WelcomeTitle}" />
        <TextBlock Classes="sub" Text="{x:Static ui:UiText.WelcomeBody}" TextWrapping="Wrap" />

        <!-- Facts card (2 columns, light gray background, green bullet) -->
        <Border Background="{StaticResource CardBgBrush}" CornerRadius="8" Padding="14,12" Margin="0,4,0,4">
          <ItemsControl ItemsSource="{Binding WelcomeFacts}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,*" Margin="0,4,12,4">
                  <TextBlock Grid.Column="0" Text="•" Foreground="{StaticResource BrandBrush}" FontWeight="ExtraBold" FontSize="14" VerticalAlignment="Top" />
                  <TextBlock Grid.Column="1" Classes="fact" Text="{Binding}" TextWrapping="Wrap" Margin="6,0,0,0" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <!-- Checkbox with subtext -->
        <StackPanel Margin="0,6,0,0" Spacing="2">
          <CheckBox Name="WelcomeStartAtSignInCheck"
                    AutomationProperties.AutomationId="WelcomeStartAtSignInCheck"
                    Content="{x:Static ui:UiText.StartAtSignInLabel}"
                    IsChecked="{Binding StartAtSignIn, Mode=TwoWay}"
                    FontWeight="SemiBold" />
          <TextBlock Classes="hint"
                     Margin="28,0,0,0"
                     Text="ERPNext will be ready a minute or two after you sign in. You can change this later."
                     TextWrapping="Wrap" />
        </StackPanel>

        <!-- Action: Right aligned big primary button -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
          <Button Name="StartSetupButton"
                  AutomationProperties.AutomationId="StartSetupButton"
                  Classes="primary big"
                  Command="{Binding StartSetupCommand}"
                  Content="{x:Static ui:UiText.StartSetup}" />
        </StackPanel>

        <views:DetailsPanel Margin="0,12,0,0" />
      </StackPanel>
    </ScrollViewer>

    <!-- ============ 3 · Checking your PC (mockup s3) ============ -->
    <ScrollViewer IsVisible="{Binding ShowChecking}">
      <StackPanel Name="CheckingScreen"
                  AutomationProperties.AutomationId="CheckingScreen"
                  Margin="22,18,22,20"
                  Spacing="12">
        <views:Strip />
        <TextBlock Classes="h1" Text="{x:Static ui:UiText.CheckingTitle}" />
        <TextBlock Classes="sub" Text="{x:Static ui:UiText.StayAwake}" TextWrapping="Wrap" />
        <ProgressBar Height="8" CornerRadius="4" IsIndeterminate="True" Margin="0,6,0,0" />
        <TextBlock Text="{Binding ActivityText}" Classes="muted" FontSize="12.5" IsVisible="{Binding ActivityText.Length}" Margin="0,4,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
          <Button Name="CheckAgainButton"
                  AutomationProperties.AutomationId="CheckAgainButton"
                  Command="{Binding CheckAgainCommand}"
                  Content="{x:Static ui:UiText.CheckAgain}" />
        </StackPanel>
        <views:DetailsPanel Margin="0,12,0,0" />
      </StackPanel>
    </ScrollViewer>

    <!-- ============ 3b · Cannot run yet (mockup s4) ============ -->
    <ScrollViewer IsVisible="{Binding ShowCannotRun}">
      <StackPanel Name="CannotRunScreen"
                  AutomationProperties.AutomationId="CannotRunScreen"
                  Margin="22,18,22,20"
                  Spacing="12">
        <!-- Error banner matching mockup .banner -->
        <Border Background="{StaticResource BadBgBrush}" BorderBrush="{StaticResource BadBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
          <Grid ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="{StaticResource BadBrush}" VerticalAlignment="Top" Margin="0,2,0,0">
              <TextBlock Text="!" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="4">
              <TextBlock Name="CannotRunHeadlineText"
                         AutomationProperties.AutomationId="CannotRunHeadlineText"
                         Text="{Binding FailureHeadline}"
                         FontWeight="Bold" FontSize="14.5"
                         Foreground="{StaticResource BadTitleBrush}" />
              <TextBlock Text="{Binding FailureDetail}"
                         Foreground="{StaticResource BadTextBrush}"
                         FontSize="13" TextWrapping="Wrap" />
              <TextBlock Name="CannotRunWhatToDoText"
                         AutomationProperties.AutomationId="CannotRunWhatToDoText"
                         Foreground="{StaticResource BadTextBrush}"
                         FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0">
                <Run Text="{x:Static ui:UiText.WhatToDoLabel}" FontWeight="Bold" />
                <Run Text=" " />
                <Run Text="{Binding FailureWhatToDo}" />
              </TextBlock>
            </StackPanel>
          </Grid>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,16,0,0">
          <Button Name="CannotRunSaveButton"
                  AutomationProperties.AutomationId="CannotRunSaveButton"
                  Command="{Binding SaveDetailsCommand}"
                  Content="{x:Static ui:UiText.SaveDetails}" />
          <Button Name="CannotRunCheckAgainButton"
                  AutomationProperties.AutomationId="CheckAgainButton"
                  Classes="primary"
                  Command="{Binding CheckAgainCommand}"
                  Content="{x:Static ui:UiText.CheckAgain}" />
        </StackPanel>
        <views:DetailsPanel Margin="0,12,0,0" />
      </StackPanel>
    </ScrollViewer>

    <!-- ============ If needed · Windows restart (mockup s5) ============ -->
    <ScrollViewer IsVisible="{Binding ShowRestartNeeded}">
      <StackPanel Name="RestartScreen"
                  AutomationProperties.AutomationId="RestartScreen"
                  Margin="22,18,22,20"
                  Spacing="12">
        <views:Strip />
        <TextBlock Name="RestartHeadlineText"
                   AutomationProperties.AutomationId="RestartHeadlineText"
                   Classes="h1"
                   Text="{Binding FailureHeadline}" />
        <TextBlock Classes="sub" Text="{Binding FailureDetail}" TextWrapping="Wrap" />
        <TextBlock Classes="hint" Text="{Binding FailureWhatToDo}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,16,0,0">
          <Button Name="RestartLaterButton"
                  AutomationProperties.AutomationId="RestartLaterButton"
                  Command="{Binding RestartLaterCommand}"
                  Content="{x:Static ui:UiText.RestartLater}" />
          <Button Name="RestartNowButton"
                  AutomationProperties.AutomationId="RestartNowButton"
                  Classes="primary"
                  Command="{Binding RestartNowCommand}"
                  Content="{x:Static ui:UiText.RestartNow}" />
        </StackPanel>
        <views:DetailsPanel Margin="0,12,0,0" />
      </StackPanel>
    </ScrollViewer>

    <!-- ============ If needed · Password for existing data (mockup s14) ============ -->
    <ScrollViewer IsVisible="{Binding ShowPasswordNeeded}">
      <StackPanel Name="PasswordScreen"
                  AutomationProperties.AutomationId="PasswordScreen"
                  Margin="22,18,22,20"
                  Spacing="12">
        <TextBlock Classes="h1" Text="{x:Static ui:UiText.PasswordTitle}" />
        <TextBlock Classes="sub" Text="{x:Static ui:UiText.PasswordBody}" TextWrapping="Wrap" />
        <StackPanel Spacing="6" Margin="0,6,0,0">
          <TextBlock Text="Password for the ERPNext user &quot;Administrator&quot;" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
          <TextBox Name="PasswordInput"
                   AutomationProperties.AutomationId="PasswordInput"
                   PasswordChar="•"
                   FontSize="14"
                   Padding="12,9"
                   CornerRadius="8"
                   BorderBrush="#B9C1CA"
                   Text="{Binding PasswordInput, Mode=TwoWay}" />
          <TextBlock Name="PasswordWrongText"
                     Foreground="{StaticResource BadBrush}"
                     FontSize="12.5"
                     IsVisible="{Binding PasswordWrongVisible}"
                     Text="{x:Static ui:UiText.PasswordWrong}" />
          <TextBlock Classes="hint"
                     Text="Serpy keeps the password on this PC, locked to your Windows account. It uses it only to check that ERPNext is working."
                     TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,16,0,0">
          <Button Name="PasswordCancelButton"
                  AutomationProperties.AutomationId="PasswordCancelButton"
                  Command="{Binding CancelPasswordCommand}"
                  Content="{x:Static ui:UiText.Cancel}" />
          <Button Name="PasswordSubmitButton"
                  AutomationProperties.AutomationId="PasswordSubmitButton"
                  Classes="primary"
                  Command="{Binding SubmitPasswordCommand}"
                  Content="{x:Static ui:UiText.Continue}" />
        </StackPanel>
        <views:DetailsPanel Margin="0,12,0,0" />
      </StackPanel>
    </ScrollViewer>

    <!-- ============ 4 · Downloads (mockup s6/s7) ============ -->
    <ScrollViewer IsVisible="{Binding ShowDownloads}">
      <StackPanel Name="DownloadsScreen"
                  AutomationProperties.AutomationId="DownloadsScreen"
                  Margin="22,18,22,20"
                  Spacing="12">
        <views:Strip />
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
          <TextBlock Classes="h1" Text="{x:Static ui:UiText.DownloadsTitle}" FontSize="13.5" FontWeight="Bold" Margin="0" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Name="CachedPartsText" Text="{Binding CachedPartsLine}" Classes="muted" FontSize="12.5" VerticalAlignment="Center" />
        </Grid>
        <ProgressBar Height="10" CornerRadius="5" Minimum="0" Maximum="100" Value="{Binding OverallPercent}" Margin="0,2,0,8" />
        <ItemsControl ItemsSource="{Binding DownloadParts}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DownloadPartItem">
              <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource LineBrush}" Padding="0,7,0,7">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                  <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="{Binding FileCountText}" Classes="muted" FontSize="12" IsVisible="{Binding ShowFileCount}" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StateText}" Classes="muted" FontSize="12" HorizontalAlignment="Right" />
                  <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Classes="thin" Margin="0,5,0,0"
                               Minimum="0" Maximum="100" Value="{Binding Percent}"
                               IsIndeterminate="{Binding IsIndeterminate}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="hint" Text="{x:Static ui:UiText.DownloadsMostlyCached}" TextWrapping="Wrap" Margin="0,4,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
          <Button Name="DownloadsCancelButton"
                  Command="{Binding CancelSetupCommand}"
                  Content="{x:Static ui:UiText.Cancel}" />
        </StackPanel>
        <views:DetailsPanel Margin="0,12,0,0" />
      </StackPanel>
    </ScrollViewer>

    <!-- ============ 5 · Installing (mockup s8/s9/s10) ============ -->
    <ScrollViewer IsVisible="{Binding ShowInstalling}">
      <StackPanel Name="InstallingScreen"
                  AutomationProperties.AutomationId="InstallingScreen"
                  Margin="22,18,22,20"
                  Spacing="12">
        <views:Strip />
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
          <TextBlock Classes="h1" Text="{x:Static ui:UiText.InstallingTitle}" FontSize="13.5" FontWeight="Bold" Margin="0" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Name="StepElapsedText" AutomationProperties.AutomationId="StepElapsedText" Classes="muted" FontSize="12.5" Text="{Binding StepElapsedText}" VerticalAlignment="Center" />
        </Grid>
        <ProgressBar Name="OverallProgressBar"
                     AutomationProperties.AutomationId="OverallProgressBar"
                     Height="10"
                     CornerRadius="5"
                     Minimum="0"
                     Maximum="100"
                     Value="{Binding OverallPercent, Mode=OneWay}"
                     Margin="0,2,0,6" />

        <!-- Step gone quiet warning banner (mockup s9) -->
        <Border Name="QuietBanner"
                AutomationProperties.AutomationId="QuietBanner"
                Background="{StaticResource WarnBgBrush}"
                BorderBrush="{StaticResource WarnBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,12"
                Margin="0,0,0,8"
                IsVisible="{Binding ShowQuietBanner}">
          <Grid ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="{StaticResource WarnBrush}" VerticalAlignment="Top" Margin="0,2,0,0">
              <TextBlock Text="!" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="4">
              <TextBlock Text="This step is taking longer than usual" FontWeight="Bold" FontSize="14.5" Foreground="{StaticResource WarnTitleBrush}" />
              <TextBlock Classes="muted" Foreground="{StaticResource WarnTextBrush}" TextWrapping="Wrap" FontSize="13">
                <Run Text="{x:Static ui:UiText.WhatToDoLabel}" FontWeight="Bold" />
                <Run Text=" " />
                <Run Text="{x:Static ui:UiText.QuietAdvice}" />
              </TextBlock>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <Button Name="TryAgainStepButton"
                        AutomationProperties.AutomationId="TryAgainStepButton"
                        Command="{Binding TryAgainStepCommand}"
                        Content="{x:Static ui:UiText.TryAgain}"
                        Classes="sm" />
                <Button Name="KeepWaitingButton"
                        AutomationProperties.AutomationId="KeepWaitingButton"
                        Classes="primary sm"
                        Command="{Binding KeepWaitingCommand}"
                        Content="{x:Static ui:UiText.KeepWaiting}" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Now line box matching mockup .now-line -->
        <Border Background="#F4F8F6" BorderBrush="#DBE9E2" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
            <TextBlock Name="ActivityText"
                       AutomationProperties.AutomationId="ActivityText"
                       Grid.Row="0" Grid.Column="0"
                       Text="{Binding ActivityText}"
                       FontSize="12.5"
                       Foreground="{StaticResource InkBrush}"
                       TextWrapping="Wrap" />
            <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Classes="thin" IsIndeterminate="True" Margin="0,8,0,0" Foreground="{StaticResource BrandBrush}" />
          </Grid>
        </Border>

        <TextBlock Classes="hint" Text="{x:Static ui:UiText.StayAwake}" TextWrapping="Wrap" Margin="0,4,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
          <Button Name="CancelSetupButton"
                  AutomationProperties.AutomationId="CancelSetupButton"
                  Command="{Binding CancelSetupCommand}"
                  Content="{x:Static ui:UiText.Cancel}" />
        </StackPanel>
        <views:DetailsPanel Margin="0,12,0,0" />
      </StackPanel>
    </ScrollViewer>

    <!-- ============ 6 · Ready (mockup s11) ============ -->
    <ScrollViewer IsVisible="{Binding ShowReady}">
      <StackPanel Name="ReadyScreen"
                  AutomationProperties.AutomationId="ReadyScreen"
                  Margin="22,10,22,10"
                  Spacing="6"
                  HorizontalAlignment="Center">
        <!-- Big check mark -->
        <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource OkBrush}" HorizontalAlignment="Center" Margin="0,2,0,2">
          <TextBlock Text="✓" Foreground="#FFFFFF" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Classes="h1" Text="{x:Static ui:UiText.ReadyTitle}" TextAlignment="Center" HorizontalAlignment="Center" />
        <TextBlock Classes="sub" Text="{x:Static ui:UiText.ReadyBody}" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" />

        <!-- Credentials card matching mockup .cred -->
        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Width="330" HorizontalAlignment="Center" Margin="0,4,0,0" Background="#FFFFFF">
          <StackPanel>
            <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="12,6">
              <TextBlock Text="Sign in to ERPNext with" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
            </Border>
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,6">
              <TextBlock Grid.Column="0" Classes="muted" Text="{x:Static ui:UiText.UsernameLabel}" Width="84" FontSize="12.5" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Name="ReadyUsernameText" Text="{Binding ReadyUsername}" FontFamily="Cascadia Code,Consolas,monospace" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" />
              <Button Grid.Column="2" Classes="sm" Content="Copy" Command="{Binding CopyUsernameCommand}" />
            </Grid>
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" />
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,6">
              <TextBlock Grid.Column="0" Classes="muted" Text="{x:Static ui:UiText.PasswordLabel}" Width="84" FontSize="12.5" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Name="ReadyPasswordText" Text="{Binding ReadyPassword}" FontFamily="Cascadia Code,Consolas,monospace" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" />
              <Button Grid.Column="2" Classes="sm" Content="Copy" Command="{Binding CopyPasswordCommand}" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Actions: Big primary button centered -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,10,0,0">
          <Button Name="OpenErpNextButton"
                  AutomationProperties.AutomationId="OpenErpNextButton"
                  Classes="primary big"
                  Command="{Binding OpenErpNextCommand}"
                  Content="{x:Static ui:UiText.OpenErpNext}" />
          <Button Name="ReadySaveButton"
                  AutomationProperties.AutomationId="ReadySaveButton"
                  Command="{Binding SaveDetailsCommand}"
                  Content="{x:Static ui:UiText.SaveDetails}"
                  IsVisible="False" />
        </StackPanel>
        <TextBlock Classes="hint" Text="Serpy stays next to the clock and shows whether ERPNext is ready." TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0" />
        <views:DetailsPanel Margin="0,8,0,0" />
      </StackPanel>
    </ScrollViewer>

    <!-- ============ Problem · setup stopped (mockup s12/s13) ============ -->
    <ScrollViewer IsVisible="{Binding ShowProblem}">
      <StackPanel Name="ProblemScreen"
                  AutomationProperties.AutomationId="ProblemScreen"
                  Margin="22,18,22,20"
                  Spacing="12">
        <views:Strip />
        <!-- Error banner matching mockup .banner -->
        <Border Background="{StaticResource BadBgBrush}" BorderBrush="{StaticResource BadBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
          <Grid ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="{StaticResource BadBrush}" VerticalAlignment="Top" Margin="0,2,0,0">
              <TextBlock Text="!" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="4">
              <TextBlock Name="FailureHeadlineText"
                         AutomationProperties.AutomationId="FailureHeadlineText"
                         Text="{Binding FailureHeadline}"
                         FontWeight="Bold" FontSize="14.5"
                         Foreground="{StaticResource BadTitleBrush}" />
              <TextBlock Text="{Binding FailureDetail}"
                         Foreground="{StaticResource BadTextBrush}"
                         FontSize="13" TextWrapping="Wrap" />
              <TextBlock Name="FailureWhatToDoText"
                         AutomationProperties.AutomationId="FailureWhatToDoText"
                         Foreground="{StaticResource BadTextBrush}"
                         FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0">
                <Run Text="{x:Static ui:UiText.WhatToDoLabel}" FontWeight="Bold" />
                <Run Text=" " />
                <Run Text="{Binding FailureWhatToDo}" />
              </TextBlock>
            </StackPanel>
          </Grid>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,16,0,0">
          <Button Name="SaveDetailsButton"
                  AutomationProperties.AutomationId="SaveDetailsButton"
                  Command="{Binding SaveDetailsCommand}"
                  Content="{x:Static ui:UiText.SaveDetails}" />
          <Button Name="TryAgainButton"
                  AutomationProperties.AutomationId="TryAgainButton"
                  Classes="primary"
                  Command="{Binding TryAgainCommand}"
                  Content="{x:Static ui:UiText.TryAgain}" />
        </StackPanel>
        <views:DetailsPanel Margin="0,12,0,0" />
      </StackPanel>
    </ScrollViewer>
  </Panel>
</UserControl>
