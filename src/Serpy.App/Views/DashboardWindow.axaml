<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Serpy.App.ViewModels"
        x:Class="Serpy.App.Views.DashboardWindow"
        x:DataType="vm:DashboardViewModel"
        Title="Serpy"
        Width="520" Height="460"
        MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterScreen">

  <DockPanel Margin="20">

    <!-- Header: brand + status badge -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,14">
      <TextBlock Text="Serpy" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
      <Border Background="#EEF1F4" CornerRadius="12" Padding="10,5">
        <TextBlock AutomationProperties.AutomationId="StatusBadge" Text="{Binding StatusBadgeText}" FontSize="13" FontWeight="SemiBold"/>
      </Border>
      <!-- Loopback URL when healthy -->
      <TextBlock AutomationProperties.AutomationId="LoopbackUrlText"
                 Text="{Binding Status.LoopbackUrl}"
                 FontSize="12" Foreground="#2563EB"
                 VerticalAlignment="Center"
                 IsVisible="{Binding IsHealthy}"/>
    </StackPanel>

    <!-- Stage text + progress -->
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,14">
      <TextBlock AutomationProperties.AutomationId="StageText" Text="{Binding StageText}" FontSize="13" Foreground="#6B7280"/>
      <ProgressBar AutomationProperties.AutomationId="ProgressBar" Value="{Binding ProgressPercent}" Maximum="100" Height="8" CornerRadius="4"/>
    </StackPanel>

    <!-- Primary action row -->
    <!-- Primary action follows readiness/health, not a fixed Start command. -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <Button AutomationProperties.AutomationId="PrimaryActionButton"
              Content="{Binding PrimaryActionLabel}"
              Command="{Binding PrimaryActionCommand}"
              IsEnabled="{Binding CanExecutePrimaryAction}"
              Classes="accent"/>

      <!-- Build (NotBuilt only) -->
      <Button AutomationProperties.AutomationId="BuildButton"
              Content="Build…"
              Command="{Binding BuildCommand}"
              IsVisible="{Binding !CanStart}"/>

      <!-- Initialize (Built only) -->
      <Button AutomationProperties.AutomationId="InitializeButton"
              Content="Initialize…"
              Command="{Binding InitializeCommand}"/>

      <!-- Stop -->
      <Button AutomationProperties.AutomationId="StopButton"
              Content="Stop"
              Command="{Binding StopCommand}"
              IsEnabled="{Binding CanStop}"/>

      <!-- Restart -->
      <Button AutomationProperties.AutomationId="RestartButton"
              Content="Restart"
              Command="{Binding RestartCommand}"
              IsEnabled="{Binding CanRestart}"/>

      <Button AutomationProperties.AutomationId="RecoverButton"
              Content="Recover…"
              Command="{Binding RecoverCommand}"
              IsEnabled="{Binding CanRecover}"/>

      <!-- Open ERPNext (healthy only) -->
      <Button AutomationProperties.AutomationId="OpenErpNextButton"
              Content="Open ERPNext ↗"
              Command="{Binding OpenErpNextCommand}"
              IsEnabled="{Binding IsHealthy}"/>

      <!-- Cancel in-flight operation -->
      <Button AutomationProperties.AutomationId="CancelButton"
              Content="✕"
              Command="{Binding CancelCommand}"
              IsEnabled="{Binding IsOperationRunning}"
              ToolTip.Tip="Cancel current operation"/>
    </StackPanel>

    <CheckBox AutomationProperties.AutomationId="StartAtSignInCheckbox"
              DockPanel.Dock="Top"
              Margin="0,8,0,0"
              Content="Start Serpy at sign-in"
              IsChecked="{Binding StartAtSignIn}"
              Command="{Binding SetAutostartCommand}"
              CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}" />

    <!-- Show-details disclosure (off by default, R17) -->
    <Expander AutomationProperties.AutomationId="DetailsExpander"
              DockPanel.Dock="Bottom"
              Header="Show details"
              IsExpanded="{Binding ShowDetails}"
              Margin="0,8,0,0">
      <ScrollViewer MaxHeight="160">
        <TextBlock AutomationProperties.AutomationId="DetailLogText"
                   Text="{Binding DetailLog}"
                   FontFamily="Cascadia Code,Consolas,monospace"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Padding="10"/>
      </ScrollViewer>
    </Expander>

    <Grid/>
  </DockPanel>
</Window>
