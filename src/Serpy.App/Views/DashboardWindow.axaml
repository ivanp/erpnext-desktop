<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Serpy.App.ViewModels"
        xmlns:views="using:Serpy.App.Views"
        x:Class="Serpy.App.Views.DashboardWindow"
        x:DataType="vm:DashboardViewModel"
        Title="Serpy"
        Width="540" Height="480"
        MinWidth="460" MinHeight="400"
        Background="{StaticResource PanelBrush}"
        Foreground="{StaticResource InkBrush}"
        FontFamily="Segoe UI, -apple-system, system-ui, sans-serif"
        WindowStartupLocation="CenterScreen">

  <Panel>
    <!-- Guided setup screens (U9); dashboard stays mounted beneath for status-driven compatibility -->
    <Panel x:Name="SetupHostPanel" IsVisible="{Binding Setup.SetupActive}">
      <views:SetupView x:Name="SetupScreenHost"
                       AutomationProperties.AutomationId="SetupScreenHost"
                       DataContext="{Binding Setup}"
                       IsVisible="{Binding #SetupHostPanel.IsVisible}" />
    </Panel>

    <!-- Everyday dashboard (U10) -->
    <views:EverydayView IsVisible="{Binding !Setup.SetupActive}" />
  </Panel>
</Window>
