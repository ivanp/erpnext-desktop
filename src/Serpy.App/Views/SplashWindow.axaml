<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Serpy.App.ViewModels"
        x:Class="Serpy.App.Views.SplashWindow"
        x:DataType="vm:SplashViewModel"
        Title="Serpy"
        Width="340" Height="190"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        SystemDecorations="None"
        Background="White">

  <Border CornerRadius="12" BoxShadow="0 8 32 0 #55000000" Background="White" Padding="24">
    <StackPanel Spacing="14">

      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
        <Border Width="38" Height="38" CornerRadius="10" Background="#2F6F4F">
          <TextBlock Text="S" Foreground="White" FontSize="20" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Serpy" FontSize="18" FontWeight="Bold"/>
          <TextBlock Text="powered by ERPNext" FontSize="11" Foreground="#6B7280"/>
        </StackPanel>
      </StackPanel>

      <TextBlock Text="{Binding StageText}"
                 FontSize="12.5" Foreground="#6B7280"
                 HorizontalAlignment="Center"
                 TextWrapping="Wrap" TextAlignment="Center"/>

      <ProgressBar Value="{Binding ProgressPercent}"
                   Maximum="100"
                   IsIndeterminate="{Binding IsIndeterminate}"
                   Height="8" CornerRadius="4"/>
    </StackPanel>
  </Border>
</Window>
