<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Serpy.App.ViewModels"
             x:Class="Serpy.App.App"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <!-- Brand / palette colors from easy-install mockup -->
    <Color x:Key="BrandColor">#2F6F4F</Color>
    <Color x:Key="BrandInkColor">#1C4A34</Color>
    <Color x:Key="BrandHoverColor">#25583E</Color>
    <Color x:Key="OkColor">#2E9E5B</Color>
    <Color x:Key="WarnColor">#C98A1B</Color>
    <Color x:Key="BadColor">#C2402F</Color>
    <Color x:Key="IdleColor">#9AA3AD</Color>
    <Color x:Key="AccentColor">#2563EB</Color>
    <Color x:Key="InkColor">#1A1D21</Color>
    <Color x:Key="MutedColor">#6B7280</Color>
    <Color x:Key="LineColor">#E3E6EA</Color>
    <Color x:Key="PanelColor">#FFFFFF</Color>
    <Color x:Key="BgColor">#F4F5F7</Color>
    <Color x:Key="CardBgColor">#F7F8FA</Color>
    <Color x:Key="LogBgColor">#10151B</Color>
    <Color x:Key="LogTextColor">#CBD5E1</Color>
    <Color x:Key="BadBgColor">#FBECEA</Color>
    <Color x:Key="BadBorderColor">#F2C9C2</Color>
    <Color x:Key="BadTitleColor">#7F2419</Color>
    <Color x:Key="BadTextColor">#6D281F</Color>
    <Color x:Key="WarnBgColor">#FDF5E4</Color>
    <Color x:Key="WarnBorderColor">#F0DBA8</Color>
    <Color x:Key="WarnTitleColor">#6F4A0C</Color>
    <Color x:Key="WarnTextColor">#6B4D18</Color>
    <Color x:Key="OkBgColor">#E7F6EC</Color>
    <Color x:Key="OkTextColor">#1C6B3A</Color>

    <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandColor}" />
    <SolidColorBrush x:Key="BrandInkBrush" Color="{StaticResource BrandInkColor}" />
    <SolidColorBrush x:Key="BrandHoverBrush" Color="{StaticResource BrandHoverColor}" />
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
    <SolidColorBrush x:Key="OkBgBrush" Color="{StaticResource OkBgColor}" />
    <SolidColorBrush x:Key="OkTextBrush" Color="{StaticResource OkTextColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="WarnBgBrush" Color="{StaticResource WarnBgColor}" />
    <SolidColorBrush x:Key="WarnBorderBrush" Color="{StaticResource WarnBorderColor}" />
    <SolidColorBrush x:Key="WarnTitleBrush" Color="{StaticResource WarnTitleColor}" />
    <SolidColorBrush x:Key="WarnTextBrush" Color="{StaticResource WarnTextColor}" />
    <SolidColorBrush x:Key="BadBrush" Color="{StaticResource BadColor}" />
    <SolidColorBrush x:Key="BadBgBrush" Color="{StaticResource BadBgColor}" />
    <SolidColorBrush x:Key="BadBorderBrush" Color="{StaticResource BadBorderColor}" />
    <SolidColorBrush x:Key="BadTitleBrush" Color="{StaticResource BadTitleColor}" />
    <SolidColorBrush x:Key="BadTextBrush" Color="{StaticResource BadTextColor}" />
    <SolidColorBrush x:Key="IdleBrush" Color="{StaticResource IdleColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}" />
    <SolidColorBrush x:Key="LogBgBrush" Color="{StaticResource LogBgColor}" />
    <SolidColorBrush x:Key="LogTextBrush" Color="{StaticResource LogTextColor}" />

    <!-- Expander theme matching mockup details/summary -->
    <ControlTheme x:Key="{x:Type Expander}" TargetType="Expander">
      <Setter Property="IsHitTestVisible" Value="True" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <StackPanel HorizontalAlignment="Stretch">
            <ToggleButton Name="ExpanderHeader"
                          IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0,4"
                          Cursor="Hand"
                          HorizontalAlignment="Left"
                          HorizontalContentAlignment="Left">
              <ToggleButton.Template>
                <ControlTemplate>
                  <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                  </Border>
                </ControlTemplate>
              </ToggleButton.Template>
              <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent">
                <TextBlock Name="Chevron"
                           Text="▸"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" />
                <ContentPresenter Name="PART_HeaderPresenter"
                                  Content="{TemplateBinding Header}"
                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                  Foreground="{StaticResource AccentBrush}"
                                  FontWeight="SemiBold"
                                  FontSize="12.5"
                                  VerticalAlignment="Center" />
              </StackPanel>
            </ToggleButton>

            <Border Name="ExpanderContent"
                    IsVisible="{TemplateBinding IsExpanded}"
                    HorizontalAlignment="Stretch"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent">
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </Border>
          </StackPanel>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:expanded /template/ TextBlock#Chevron">
        <Setter Property="Text" Value="▾" />
      </Style>
    </ControlTheme>
  </Application.Resources>

  <TrayIcon.Icons>
    <TrayIcons>
      <!-- x:DataType enables compiled bindings; DataContext is DashboardViewModel (set in code-behind) -->
      <TrayIcon x:DataType="vm:DashboardViewModel"
                Icon="/Assets/serpy.ico"
                ToolTipText="Serpy"
                Command="{Binding ShowDashboardCommand}">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem x:DataType="vm:DashboardViewModel"
                            Header="Open ERPNext"
                            Command="{Binding OpenErpNextCommand}"
                            IsEnabled="{Binding CanOpenErpNext}" />
            <NativeMenuItem x:DataType="vm:DashboardViewModel"
                            Header="Open Serpy"
                            Command="{Binding ShowDashboardCommand}" />
            <NativeMenuItemSeparator />
            <NativeMenuItem x:DataType="vm:DashboardViewModel"
                            Header="{Binding StartOrStopButtonLabel}"
                            Command="{Binding StartOrStopCommand}"
                            IsEnabled="{Binding CanStartOrStop}" />
            <NativeMenuItem x:DataType="vm:DashboardViewModel"
                            Header="Start Serpy when I sign in"
                            ToggleType="CheckBox"
                            IsChecked="{Binding StartAtSignIn}"
                            Command="{Binding ToggleStartAtSignInCommand}" />
            <NativeMenuItemSeparator />
            <NativeMenuItem x:DataType="vm:DashboardViewModel"
                            Header="Exit…"
                            Command="{Binding ExitCommand}" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>

  <Application.Styles>
    <FluentTheme />

    <!-- Typography styles matching mockup -->
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="19" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style Selector="TextBlock.sub">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>

    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>

    <Style Selector="TextBlock.fact">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>

    <!-- Button styles matching mockup -->
    <Style Selector="Button">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="BorderBrush" Value="#CFD5DC" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="18,9" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F7F8FA" />
      <Setter Property="BorderBrush" Value="#B9C1CA" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource BrandBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="{StaticResource BrandBrush}" />
    </Style>

    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrandHoverBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BrandHoverBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{StaticResource BrandBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="{StaticResource BrandBrush}" />
    </Style>

    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrandHoverBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BrandHoverBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="Button.big">
      <Setter Property="Padding" Value="30,12" />
      <Setter Property="FontSize" Value="15" />
    </Style>

    <Style Selector="Button.sm">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- Progress bars -->
    <Style Selector="ProgressBar">
      <Setter Property="Height" Value="10" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="#EEF1F4" />
      <Setter Property="Foreground" Value="{StaticResource BrandBrush}" />
    </Style>

    <Style Selector="ProgressBar.thin">
      <Setter Property="Height" Value="6" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>

    <!-- CheckBox -->
    <Style Selector="CheckBox">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>

    <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
      <Setter Property="Background" Value="{StaticResource BrandBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BrandBrush}" />
    </Style>

    <!-- Expander base overrides -->
    <Style Selector="Expander">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
  </Application.Styles>
</Application>
